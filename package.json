{
  "name": "wayfinder",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "nhs:fetch": "node scripts/nhs/fetch-ods.mjs",
    "nhs:geocode": "node scripts/nhs/geocode.mjs",
    "nhs:osm": "node scripts/nhs/fetch-osm.mjs",
    "nhs:build": "node scripts/nhs/build-sites.mjs",
    "nhs:venues": "node scripts/nhs/generate-venues.mjs",
    "nhs:discover": "node scripts/nhs/discover-plans.mjs",
    "nhs:plans": "node scripts/nhs/fetch-plans.mjs",
    "nhs:refresh": "npm run nhs:fetch && npm run nhs:geocode && npm run nhs:osm && npm run nhs:build && npm run nhs:venues",
    "typecheck": "tsc --noEmit",
    "nhs:test": "node scripts/nhs/test/parsing.test.mjs && node scripts/nhs/test/build.test.mjs && node scripts/nhs/test/ingest.test.mjs",
    "nhs:approve": "node scripts/nhs/approve-plans.mjs",
    "nhs:draft": "node scripts/nhs/draft-sheets.mjs",
    "nhs:registry": "node scripts/nhs/generate-registry.mjs",
    "nhs:previews": "node scripts/nhs/preview-sheets.mjs",
    "nhs:ingest": "npm run nhs:approve && npm run nhs:plans && npm run nhs:draft && node scripts/maps/generate-all.mjs && node scripts/maps/build-venues.mjs && npm run nhs:registry && npm run nhs:previews && npm run nhs:build && npm run nhs:venues",
    "nhs:doctor": "node scripts/nhs/doctor.mjs",
    "nhs:discover:quick": "node scripts/nhs/discover-plans.mjs --limit 20"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.101.0",
    "@clerk/nextjs": "^7.5.20",
    "@types/leaflet": "^1.9.21",
    "@types/qrcode": "^1.5.6",
    "jsqr": "^1.4.0",
    "leaflet": "^1.9.4",
    "lucide-react": "^1.16.0",
    "next": "16.2.6",
    "pdfjs-dist": "^6.1.200",
    "pg": "^8.22.0",
    "qrcode": "^1.5.4",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "react-leaflet": "^5.0.0",
    "three": "^0.171.0"
  },
  "engines": {
    "node": ">=20.9.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/pg": "^8.20.0",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/three": "^0.171.0",
    "eslint": "^9",
    "eslint-config-next": "16.2.6",
    "sharp": "^0.34.4",
    "tailwindcss": "^4",
    "typescript": "^5"
  }
}
